@inherits LayoutComponentBase
@inject AppSettingsService Settings
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="eg-topbar-badge"><span class="dot"></span> @Settings.AppName · @Settings.Subtitle</span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<ToastHost />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized() => Settings.Changed += OnSettingsChanged;
    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Settings.Changed -= OnSettingsChanged;
}
