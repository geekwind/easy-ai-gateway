@page "/logs"
@inject HttpClient Http
@using EasyGateway.Services

<PageTitle>调用日志</PageTitle>

<div class="eg-pagehead">
    <div>
        <h1 class="eg-title">调用日志</h1>
        <p class="eg-sub">请求链路：模型别名 → 真实上游模型</p>
    </div>
    <button class="btn btn-outline-primary btn-sm" @onclick="LoadAsync" disabled="@loading">
        @if (loading) { <span class="spinner-border spinner-border-sm"></span> } else { <text>刷新</text> }
    </button>
</div>

<UsageFilterBar ShowKeyword="true" ShowStatus="true" OnApply="OnFilter" />

@if (loading)
{
    <p><span class="spinner-border spinner-border-sm"></span> 加载中...</p>
}
else if (logs is null || logs.Count == 0)
{
    <div class="alert alert-info">没有符合条件的调用记录。</div>
}
else
{
    <div class="eg-table-card">
    <table class="table table-hover table-sm align-middle eg-logtable">
        <thead>
            <tr>
                <th style="width:84px">时间</th>
                <th>调用链路 (别名 → 真实模型)</th>
                <th style="width:120px">服务</th>
                <th style="width:56px">状态</th>
                <th style="width:132px">Tokens (P/C/T)</th>
                <th style="width:64px">缓存</th>
                <th style="width:96px">延迟</th>
                <th style="width:80px">首字</th>
                <th style="width:48px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in logs)
            {
                var expanded = expandedId == RowId(l);
                <tr class="eg-logrow @(expanded ? "open" : "")" @onclick="() => Toggle(l)">
                    <td><small>@l.timestamp?.Substring(11, 8)</small></td>
                    <td>
                        <span class="eg-chain">
                            <code>@l.model</code>
                            @if (!string.IsNullOrEmpty(l.upstreamModel) && l.upstreamModel != l.model)
                            {
                                <span class="eg-chain-arrow">→</span>
                                <code class="eg-chain-up">@l.upstreamModel</code>
                            }
                        </span>
                    </td>
                    <td><small>@l.service</small></td>
                    <td>
                        @if (l.success) { <span class="badge bg-success">✓</span> }
                        else { <span class="badge bg-danger">@l.statusCode</span> }
                    </td>
                    <td><small>@UiFormat.N(l.promptTokens) / @UiFormat.N(l.completionTokens) / @UiFormat.N(l.totalTokens)</small></td>
                    <td>
                        @if (l.cacheHit) { <span class="badge bg-info">命中</span> }
                        else if (l.cacheCreationTokens > 0 || l.cacheReadTokens > 0) { <span class="badge bg-secondary">缓存</span> }
                        else { <small class="text-muted">-</small> }
                    </td>
                    <td><small>@UiFormat.Ms(l.latencyMs)</small></td>
                    <td><small>@(l.ttftMs > 0 ? UiFormat.Ms(l.ttftMs) : "-")</small></td>
                    <td class="text-muted text-center">@(expanded ? "▾" : "▸")</td>
                </tr>
                @if (expanded)
                {
                    <tr class="eg-logdetail">
                        <td colspan="9">
                            <div class="eg-detail-grid">
                                <div>
                                    <div class="eg-detail-label">Prompt</div>
                                    <div class="eg-detail-box">@l.promptPreview</div>
                                </div>
                                <div>
                                    <div class="eg-detail-label">Response</div>
                                    <div class="eg-detail-box">@l.responsePreview</div>
                                </div>
                            </div>
                            <div class="eg-detail-meta">
                                <span><strong>Provider:</strong> @l.provider</span>
                                @if (!string.IsNullOrEmpty(l.upstreamModel))
                                { <span><strong>上游模型:</strong> @l.upstreamModel</span> }
                                @if (l.reasoningTokens > 0)
                                { <span><strong>推理 tokens:</strong> @UiFormat.N(l.reasoningTokens)</span> }
                                @if (l.stream)
                                { <span><strong>流式</strong></span> }
                                @if (!string.IsNullOrEmpty(l.error))
                                { <span class="text-danger"><strong>错误:</strong> @Trunc(l.error, 200)</span> }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
}

@code {
    private List<CallLog>? logs;
    private bool loading = true;
    private string? expandedId;
    private UsageFilterBar.FilterValues filter = new(24, "", "", "", "", "");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnFilter(UsageFilterBar.FilterValues f) { filter = f; expandedId = null; await LoadAsync(); }

    private static string RowId(CallLog l) => $"{l.timestamp}|{l.model}|{l.latencyMs}|{l.totalTokens}";

    private void Toggle(CallLog l)
    {
        var id = RowId(l);
        expandedId = expandedId == id ? null : id;
    }

    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();
        var qs = $"?limit=100&model={Uri.EscapeDataString(filter.Model)}" +
                 $"&service={Uri.EscapeDataString(filter.Service)}&provider={Uri.EscapeDataString(filter.Provider)}" +
                 $"&status={filter.Status}&q={Uri.EscapeDataString(filter.Keyword)}";
        try { logs = await Http.GetFromJsonAsync<List<CallLog>>("/admin/call-logs" + qs); }
        catch { logs = new(); }
        loading = false;
    }

    private static string Trunc(string? s, int n) =>
        string.IsNullOrEmpty(s) ? "" : (s.Length <= n ? s : s[..n] + "...");

    private class CallLog
    {
        public string? timestamp { get; set; }
        public string? model { get; set; }
        public string? upstreamModel { get; set; }
        public string? service { get; set; }
        public string? provider { get; set; }
        public bool success { get; set; }
        public string? statusCode { get; set; }
        public int promptTokens { get; set; }
        public int completionTokens { get; set; }
        public int totalTokens { get; set; }
        public int reasoningTokens { get; set; }
        public int cacheCreationTokens { get; set; }
        public int cacheReadTokens { get; set; }
        public bool cacheHit { get; set; }
        public long latencyMs { get; set; }
        public long ttftMs { get; set; }
        public bool stream { get; set; }
        public string? promptPreview { get; set; }
        public string? responsePreview { get; set; }
        public string? error { get; set; }
    }
}
